<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Automatic call tracking.

      READ_PHONE_STATE  - tells us when a call starts and ends.
      READ_CALL_LOG     - lets us read the number and the exact duration the
                          platform recorded once the call finishes.
      CALL_PHONE        - lets the app dial a lead directly.

      READ_CALL_LOG is a restricted permission on Google Play: only apps that
      are the user's default phone/dialer app are normally allowed to publish
      with it. Distribute this APK directly to your team (or through Managed
      Google Play as a private app) - see android/README.md.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!--
      Optional. Lets the post-call prompt say "Is Rajesh a lead?" instead of
      showing a bare number, which turns saving into a single tap. Everything
      still works without it.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Telephony is required for call tracking, so the app is phone-only. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="true" />

    <application
        android:name=".LeadManagerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LeadManager"
        tools:targetApi="35">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LeadManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The post-call popup. Shown on top of whatever is on screen the moment
          a call with a lead ends, so the telecaller can log the outcome and set
          the next callback without hunting for the app.
        -->
        <activity
            android:name=".call.PostCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:showOnLockScreen="true"
            android:taskAffinity=""
            android:theme="@style/Theme.LeadManager.Transparent" />

        <receiver
            android:name=".call.CallStateReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.PHONE_STATE" />
                <action android:name="android.intent.action.NEW_OUTGOING_CALL" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".sync.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Fires the local reminder notification for a scheduled callback. -->
        <receiver
            android:name=".notif.ReminderReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Handles the "Yes, add lead" / "No" buttons on the post-call prompt. -->
        <receiver
            android:name=".call.PostCallActionReceiver"
            android:enabled="true"
            android:exported="false" />


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
