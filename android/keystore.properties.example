# Release signing configuration.
#
# Copy this file to keystore.properties (which is git-ignored) and fill it in.
# Without it the release build still compiles, but the APK comes out unsigned
# and Android will refuse to install it.
#
# Create the keystore once:
#
#   keytool -genkeypair -v \
#     -keystore leadtrack-release.keystore \
#     -alias leadtrack \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass 'YOUR_PASSWORD' -keypass 'YOUR_PASSWORD' \
#     -dname "CN=Your Agency, O=Your Agency, L=Kochi, ST=Kerala, C=IN"
#
# KEEP THE KEYSTORE FILE AND PASSWORD SAFE AND BACKED UP.
# Android identifies an app by its signing key: lose this file and you can never
# ship an update to the phones that already have the app installed - everyone
# would have to uninstall and reinstall.

storeFile=/absolute/path/to/leadtrack-release.keystore
storePassword=YOUR_PASSWORD
keyAlias=leadtrack
keyPassword=YOUR_PASSWORD
